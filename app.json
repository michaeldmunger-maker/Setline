{
  "expo": {
    "name": "Setline",
    "slug": "setline-training",
    "version": "0.1.0",
    "scheme": "setline",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.setline.prototype"
    },
    "android": {
      "package": "com.setline.prototype"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing"
    ]
  }
}
